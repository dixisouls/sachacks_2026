# Copy to .env and fill in. .env is gitignored and must never be committed.
#   cp .env.example .env

# Required for the hypothesis brief (api/brief.py).
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional.
GEMINI_MODEL=gemini-2.5-pro        # gemini-2.5-flash is faster and cheaper
LOG_LEVEL=INFO                     # DEBUG for per-step timing
LOG_FORMAT=                        # json when hosted
CORS_ORIGINS=                      # comma separated; default allows any localhost port
NCBI_API_KEY=                      # raises the PubMed rate limit from 3/s to 10/s
OPENFDA_API_KEY=                   # raises the openFDA daily limit
