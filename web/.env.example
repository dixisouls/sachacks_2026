# FastAPI backend (api/main.py). Locally: python -m uvicorn api.main:app --port 8000
# Use 127.0.0.1, not localhost: "localhost" can try IPv6 first and add ~200 ms to every request.
# Leave empty to run the UI on the offline snapshot in src/lib/fixtures.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# Force the offline snapshot even when NEXT_PUBLIC_API_URL is set.
NEXT_PUBLIC_USE_MOCKS=false
